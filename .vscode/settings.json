{
	"clangd.arguments": [
		"--background-index",
		"--compile-commands-dir=${workspaceFolder}",
		"--header-insertion=never"
	],
	"clangd.fallbackFlags": [
		"-x", "c",
		"-I${workspaceFolder}",
		"-I${workspaceFolder}/includes",
		"-I${workspaceFolder}/logs",
		"-I${workspaceFolder}/libft",
		"-I${workspaceFolder}/libft/src/buff",
		"-I${workspaceFolder}/libft/src/buff/format",
		"-I${workspaceFolder}/libft/src/hashmap",
		"-I${workspaceFolder}/libft/src/hashmap/buckets",
		"-I${workspaceFolder}/libft/src/hashmap/key_value",
		"-I${workspaceFolder}/1_grammar/includes",
		"-I${workspaceFolder}/2_generator/includes",
		"-I${workspaceFolder}/2_generator/srcs/2_serialize",
		"-I${workspaceFolder}/2_generator/srcs/2_serialize/write_c_file",
		"-I${workspaceFolder}/3_generated/includes",
		"-I${workspaceFolder}/4_shell/includes",
		"-I${workspaceFolder}/lr_generator",
	]
}