{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug minishell",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/minishell",
			"args": [
				"-c",
				"cat << EOF cmd << SECOND lol\nbody\nEOF\nbody2\nSECOND\necho"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"MIMode": "lldb",
			"preLaunchTask": "make debug",
			"externalConsole": false
		}
	]
}